<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BudgetApp.ItemEditWindow"
        Title="Редактирование статьи" Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" FontSize="14">

  <Window.Styles>
    <Style Selector="Button.mini">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <StackPanel Margin="16" Spacing="10">

    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>

    <!-- Название и план статьи -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Width="230" Text="{Binding Name}" Watermark="название статьи"/>
      <TextBox Width="100" Text="{Binding PlanText}" Watermark="план"/>
      <Button Content="Применить" Click="OnAddExpense"/>
    </StackPanel>

    <TextBlock Text="Траты этого месяца" FontWeight="Bold" Margin="0,8,0,0"/>

    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Expenses}" Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="100,90,*,Auto" Margin="0,2">
              <TextBox Text="{Binding DateText}" Watermark="дата"/>
              <TextBox Grid.Column="1" Margin="6,0,0,0"
                       Text="{Binding AmountText}" Watermark="сумма"/>
              <Button Grid.Column="3" Content="✕" Classes="mini" Click="OnRemoveExpense"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button Content="Закрыть" Click="OnSave" HorizontalAlignment="Right"/>

  </StackPanel>
</Window>